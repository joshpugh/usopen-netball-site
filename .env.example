# Results source: sample | csv | json | netballconnect
SCORES_PROVIDER=netballconnect

# ── netballconnect ──────────────────────────────────────────────────────────
# Standings. Defaults to the proven GitHub Pages feed from the original scraper repo.
# Point these at this repo's own Pages feed to retire that repo:
#   https://joshpugh.github.io/<this-repo>/ladder-ladies.json
NC_LADDER_LADIES_URL=
NC_LADDER_MIXED_URL=

# Match results, published by .github/workflows/scrape.yml to this repo's Pages site.
# Leave blank and the site shows standings only (no empty "Final scores" section).
NC_FIXTURES_LADIES_URL=
NC_FIXTURES_MIXED_URL=

# ── csv: Google Sheets "Publish to web" CSV links ───────────────────────────
SCORES_MATCHES_CSV=
SCORES_STANDINGS_CSV=

# ── json: a feed shaped like lib/scores/types.ts ScoresPayload ──────────────
SCORES_JSON_URL=
SCORES_API_KEY=

# Optional: show a Pts column computed from finals. Not used by netballconnect,
# which takes real points from the official ladder.
POINTS_WIN=
POINTS_DRAW=

# YouTube video IDs (override without touching code)
NEXT_PUBLIC_STREAM_DAY1=sgTG8qF8O-Q
NEXT_PUBLIC_STREAM_DAY2=
